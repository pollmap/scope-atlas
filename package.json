{
  "name": "scope-atlas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test": "node --test --test-reporter=spec tests/data.test.mjs tests/sites-worker.test.mjs",
    "data:build": "python scripts/build-data.py",
    "deploy": "wrangler pages deploy dist/client --project-name scope-atlas --branch main",
    "audit:release": "node scripts/audit-release.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-kr": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "echarts": "^6.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "wrangler": "^4.135.0"
  },
  "description": "Source-backed company discovery and comparison",
  "engines": {
    "node": ">=22.0.0"
  }
}
